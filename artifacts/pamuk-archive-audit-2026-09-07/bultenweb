        function setTarih() {
            d = document.getElementById("bultenturu").value;
            baslamatarihi = document.getElementById("BASLAMATARIHI");
            bitistarihi = document.getElementById("BITISTARIHI");
            var options = { year: 'numeric', month: 'numeric', day: 'numeric' };
            var now = new Date().toLocaleString("tr-TR",options);
           
            switch (d) {
                case "1":
                {
                    baslamatarihi.value = now;
                    bitistarihi.value = now;
                } break;
                case "2":
                    {
                        var myDate = new Date();
                        myDate.setDate(myDate.getDate() -7);

                        baslamatarihi.value = myDate.toLocaleString("tr-TR", options);;
                        bitistarihi.value = now;
                    } break;
                case "3":
                    {
                        var myDate = new Date();
                        myDate.setDate(myDate.getDate() - 30);

                        baslamatarihi.value = myDate.toLocaleString("tr-TR", options);;
                        bitistarihi.value = now;
                    } break;
                case "4":
                    {
                        var myDate = new Date();
                        myDate.setDate(myDate.getDate() - 365);

                        baslamatarihi.value = myDate.toLocaleString("tr-TR", options);;
                        bitistarihi.value = now;
                    } break;
                case "5":
                    {
                        baslamatarihi.value = now;
                        bitistarihi.value = now;
                    } break;
            }
        }

    </script>

